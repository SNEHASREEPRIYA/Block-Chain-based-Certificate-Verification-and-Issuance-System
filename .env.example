# Local development environment variables
# Copy this file to .env and fill in your values

# Smart contract address (deployed on local Hardhat network or testnet)
VITE_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# Chain ID (31337 for local Hardhat, 11155111 for Sepolia, 1 for Mainnet)
VITE_CHAIN_ID=31337

# Optional: Testnet RPC endpoints (use with Hardhat configuration)
# SEPOLIA_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
# MAINNET_URL=https://mainnet.infura.io/v3/YOUR_INFURA_KEY

# Optional: Private key for deployments (NEVER commit this)
# PRIVATE_KEY=0x...

# Optional: Etherscan API key for contract verification
# ETHERSCAN_API_KEY=your_etherscan_api_key
